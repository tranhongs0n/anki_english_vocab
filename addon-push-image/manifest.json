{
  "manifest_version": 3,
  "name": "Anki Image Pusher",
  "version": "1.0",
  "description": "Push focused image from Google Images to Anki",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
    "http://127.0.0.1:8765/",
    "http://localhost:8765/",
    "https://*.google.com/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/search*"],
      "js": ["content.js"]
    }
  ]
}
